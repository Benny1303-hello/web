# SMTP dùng để gửi email form liên hệ (app/api/contact/route.js).
# Thiếu SMTP_HOST, SMTP_USER hoặc SMTP_PASS thì form trả lỗi "hệ thống gửi email chưa sẵn sàng".
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Mặc định 465 (TLS). Dùng 587 (STARTTLS) thì đặt SMTP_SECURE=false.
SMTP_PORT=465
# SMTP_SECURE=true

# Domain chính thức khi đã trỏ về Vercel (dùng cho sitemap, robots, link chia sẻ).
# Bỏ trống thì dùng https://web-vxfh.vercel.app
# NEXT_PUBLIC_SITE_URL=
